# Copy this file to `.env` and fill in the values. The server loads it automatically on start.
# Any value left out falls back to a "mock" mode that only prints the message to the server console.

# APP_URL: public URL of the site. Used in password-reset and email-verification links.
APP_URL="http://localhost:3000"

# --- Email (SMTP) ---------------------------------------------------------------
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<gmail address>, SMTP_PASS=<16-character Google App Password>.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- SMS (TextBee, https://textbee.dev) ---------------------------------------------
# TextBee sends SMS through an Android phone registered as a gateway device.
# TEXTBEE_API_KEY: API key from the TextBee dashboard.
# TEXTBEE_DEVICE_ID: ID of the registered device that will send the messages.
# TEXTBEE_BASE_URL: optional; only set it if you self-host TextBee.
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""
TEXTBEE_BASE_URL=""
