# Copy this file to `.env` and fill in the values. The server loads it automatically on start.
# Any value left out falls back to a "mock" mode that only prints the message to the server console.

# APP_URL: public URL of the site. Used in password-reset and email-verification links.
APP_URL="http://localhost:3000"

# --- Email (SMTP) ---------------------------------------------------------------
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<gmail address>, SMTP_PASS=<16-character Google App Password>.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- SMS (Semaphore, https://semaphore.co) ------------------------------------
# API key from the Semaphore dashboard. SEMAPHORE_SENDER_NAME is optional and must be a
# sender name approved on your Semaphore account (leave blank to use the default).
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""
